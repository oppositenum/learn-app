# syntax=docker/dockerfile:1.7

FROM golang:1.25-alpine AS build

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY schemas ./schemas
COPY server ./server

RUN CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w" -o /out/api ./server/cmd/api && \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w" -o /out/migrate ./server/cmd/migrate && \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w" -o /out/provision ./server/cmd/provision

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 learning && \
    adduser -S -D -H -u 10001 -G learning learning

WORKDIR /app
COPY --from=build --chown=10001:10001 /out/api /out/migrate /out/provision /app/

USER 10001:10001
EXPOSE 8080
CMD ["/app/api"]
