{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_public",
          "answer",
          "numeric_value",
          "unit",
          "solution",
          "solution_result",
          "misconceptions",
          "choices"
        ],
        "properties": {
          "prompt_public": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 500 },
          "numeric_value": { "type": ["number", "null"] },
          "unit": { "type": "string", "maxLength": 100 },
          "solution": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "solution_result": { "type": ["number", "null"] },
          "misconceptions": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "choices": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "correct"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 500 },
                "correct": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
