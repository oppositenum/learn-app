{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "no_answer_leak", "reason_codes"],
  "properties": {
    "result": { "enum": ["PASS", "REJECT"] },
    "no_answer_leak": { "type": "boolean" },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "DIRECT_ANSWER",
          "EQUIVALENT_ANSWER",
          "FULL_SOLUTION",
          "SEGMENT_ANSWER_LEAK",
          "NONE"
        ]
      }
    }
  }
}
