HTTP_ADDR=:8080
DATABASE_URL=postgres://learning_tutor:learning_tutor@127.0.0.1:55433/learning_tutor?sslmode=disable
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_TUTOR_OUTPUT_REVIEW_MODEL=
# Optional independent Tutor channels. Blank values fall back to the OPENAI_* settings above.
TUTOR_GENERATOR_PROVIDER=
TUTOR_GENERATOR_BASE_URL=
TUTOR_GENERATOR_API_KEY=
TUTOR_GENERATOR_MODEL=
TUTOR_GENERATOR_CONTEXT_CACHE=false
# responses | chat_completions. Pick the shape the provider actually enforces
# the schema on; see docs/architecture/provider-compat-*.md.
TUTOR_GENERATOR_API_SHAPE=responses
# JSON object merged into every request, e.g. {"thinking":{"type":"disabled"}}
# for Doubao or {"enable_thinking":false} for Qwen. It may not override the
# model, the messages/input, or the structured-output contract.
TUTOR_GENERATOR_REQUEST_OVERLAY=
TUTOR_REVIEWER_PROVIDER=
TUTOR_REVIEWER_BASE_URL=
TUTOR_REVIEWER_API_KEY=
TUTOR_REVIEWER_MODEL=
TUTOR_REVIEWER_CONTEXT_CACHE=false
TUTOR_REVIEWER_API_SHAPE=responses
TUTOR_REVIEWER_REQUEST_OVERLAY=
OPENAI_CONTENT_GENERATION_MODEL=gpt-5.6-luna
OPENAI_CONTENT_REVIEW_MODEL=
CONTENT_GENERATOR_IDENTITY=codex:content-generator
OPENAI_STT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
