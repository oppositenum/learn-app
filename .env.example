HTTP_ADDR=:8080
DATABASE_URL=postgres://learning_tutor:learning_tutor@127.0.0.1:55433/learning_tutor?sslmode=disable
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Tutor channels. OPENAI_TUTOR_MODEL and OPENAI_TUTOR_OUTPUT_REVIEW_MODEL
# are retired: a deployment still carrying them fails to start rather than
# silently using an OpenAI-only fallback. OpenAI still works by setting
# TUTOR_GENERATOR_PROVIDER=openai (and the matching reviewer channel).
TUTOR_GENERATOR_PROVIDER=
TUTOR_GENERATOR_BASE_URL=
TUTOR_GENERATOR_API_KEY=
TUTOR_GENERATOR_MODEL=
TUTOR_GENERATOR_CONTEXT_CACHE=false
# responses | chat_completions. chat_completions is the shape Doubao and Qwen
# actually enforce the schema on; see docs/architecture/provider-compat-*.md.
TUTOR_GENERATOR_API_SHAPE=chat_completions
# JSON object merged into every request. Required when Tutor is enabled so
# reasoning mode cannot spend the 75s submit budget. Compose does not fill a
# vendor default; set the syntax for the actual provider. Doubao:
# {"thinking":{"type":"disabled"}}; Qwen: {"enable_thinking":false}.
TUTOR_GENERATOR_REQUEST_OVERLAY=
TUTOR_REVIEWER_PROVIDER=
TUTOR_REVIEWER_BASE_URL=
TUTOR_REVIEWER_API_KEY=
TUTOR_REVIEWER_MODEL=
TUTOR_REVIEWER_CONTEXT_CACHE=false
TUTOR_REVIEWER_API_SHAPE=chat_completions
TUTOR_REVIEWER_REQUEST_OVERLAY=
# Content pipeline channels. OPENAI_CONTENT_GENERATION_MODEL and
# OPENAI_CONTENT_REVIEW_MODEL are retired: a deployment still carrying them
# fails to start rather than silently losing AI content generation.
CONTENT_GENERATOR_PROVIDER=
CONTENT_GENERATOR_BASE_URL=
CONTENT_GENERATOR_API_KEY=
CONTENT_GENERATOR_MODEL=
CONTENT_GENERATOR_API_SHAPE=chat_completions
CONTENT_GENERATOR_REQUEST_OVERLAY=
CONTENT_GENERATOR_CONTEXT_CACHE=false
CONTENT_REVIEWER_PROVIDER=
CONTENT_REVIEWER_BASE_URL=
CONTENT_REVIEWER_API_KEY=
CONTENT_REVIEWER_MODEL=
CONTENT_REVIEWER_API_SHAPE=chat_completions
CONTENT_REVIEWER_REQUEST_OVERLAY=
CONTENT_REVIEWER_CONTEXT_CACHE=false
# Fallback identity used only while no AI content generator is configured.
CONTENT_GENERATOR_IDENTITY=codex:content-generator
OPENAI_STT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
