POSTGRES_DB=learning_tutor
POSTGRES_USER=learning_tutor
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password below.
DATABASE_URL=postgres://learning_tutor:replace-with-a-long-random-password@postgres:5432/learning_tutor?sslmode=disable

TZ=Asia/Shanghai
# Private image registry host used by compose.deploy.yaml, e.g. registry.example.com
REGISTRY=
APP_IMAGE_TAG=local
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=18000
# Keep true behind an HTTPS reverse proxy. Set false only for local HTTP verification.
SESSION_COOKIE_SECURE=true

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=
OPENAI_CONTENT_GENERATION_MODEL=
# Must use a different provider/model identity from content generation.
OPENAI_CONTENT_REVIEW_MODEL=
CONTENT_GENERATOR_IDENTITY=codex:content-generator
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
