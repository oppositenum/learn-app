POSTGRES_DB=learning_tutor
POSTGRES_USER=learning_tutor
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password below.
DATABASE_URL=postgres://learning_tutor:replace-with-a-long-random-password@postgres:5432/learning_tutor?sslmode=disable

TZ=Asia/Shanghai
# Private image registry host used by compose.deploy.yaml, e.g. registry.example.com
REGISTRY=
APP_IMAGE_TAG=local
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=18000
# Keep true behind an HTTPS reverse proxy. Set false only for local HTTP verification.
SESSION_COOKIE_SECURE=true

# Three capabilities call providers and are configured separately. Leave a whole
# group blank to leave that capability off; a half-filled group fails at startup.

# 1. Speech (STT/TTS). All four must be set for speech routes to be enabled.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# 2. Tutor text. Prefer the channel variables below; OPENAI_TUTOR_MODEL and
# OPENAI_TUTOR_OUTPUT_REVIEW_MODEL still work as an OpenAI-only fallback, but
# they cannot express a non-OpenAI provider or wire shape.
OPENAI_TUTOR_MODEL=
OPENAI_TUTOR_OUTPUT_REVIEW_MODEL=
# API_SHAPE is responses or chat_completions. BASE_URL is required for any
# provider other than openai. The generator and reviewer provider:model
# identities must differ. CONTEXT_CACHE must stay false: ai_price_catalog has
# no cache-write price field.
TUTOR_GENERATOR_PROVIDER=
TUTOR_GENERATOR_BASE_URL=
TUTOR_GENERATOR_API_KEY=
TUTOR_GENERATOR_MODEL=
TUTOR_GENERATOR_API_SHAPE=chat_completions
# JSON object merged into every request. Required when Tutor is enabled.
# Compose does not fill a vendor default; set the syntax for the actual
# provider. Doubao: {"thinking":{"type":"disabled"}}; Qwen:
# {"enable_thinking":false}.
TUTOR_GENERATOR_REQUEST_OVERLAY=
TUTOR_GENERATOR_CONTEXT_CACHE=false
TUTOR_REVIEWER_PROVIDER=
TUTOR_REVIEWER_BASE_URL=
TUTOR_REVIEWER_API_KEY=
TUTOR_REVIEWER_MODEL=
TUTOR_REVIEWER_API_SHAPE=chat_completions
TUTOR_REVIEWER_REQUEST_OVERLAY=
TUTOR_REVIEWER_CONTEXT_CACHE=false

# 3. Content pipeline text. OPENAI_CONTENT_GENERATION_MODEL and
# OPENAI_CONTENT_REVIEW_MODEL are retired and have no fallback: the API
# container refuses to start while either is present, so remove them from any
# existing .env.production before upgrading.
CONTENT_GENERATOR_PROVIDER=
CONTENT_GENERATOR_BASE_URL=
CONTENT_GENERATOR_API_KEY=
CONTENT_GENERATOR_MODEL=
CONTENT_GENERATOR_API_SHAPE=chat_completions
CONTENT_GENERATOR_REQUEST_OVERLAY=
CONTENT_GENERATOR_CONTEXT_CACHE=false
# Must use a different provider:model identity from content generation.
CONTENT_REVIEWER_PROVIDER=
CONTENT_REVIEWER_BASE_URL=
CONTENT_REVIEWER_API_KEY=
CONTENT_REVIEWER_MODEL=
CONTENT_REVIEWER_API_SHAPE=chat_completions
CONTENT_REVIEWER_REQUEST_OVERLAY=
CONTENT_REVIEWER_CONTEXT_CACHE=false

# Not a provider channel: the placeholder identity recorded while no AI content
# generator is configured.
CONTENT_GENERATOR_IDENTITY=codex:content-generator
